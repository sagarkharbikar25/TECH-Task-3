{
  "name": "techfest-ca-parallax-experience",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node api/index.js\" \"npm run dev --prefix client\"",
    "dev:api": "node api/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "node api/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
